# Set these variables in the shell or your deployment environment before starting Spring Boot.
DATABASE_URL=jdbc:postgresql://localhost:5432/urlshortener
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-database-password
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
BASE_URL=http://localhost:8080/
BASE_SHORT_URL=http://localhost:8080/r/
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ACCESS_TOKEN_EXPIRY_SECONDS=600
REFRESH_TOKEN_EXPIRY_SECONDS=604800
